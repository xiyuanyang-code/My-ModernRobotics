+            object_mesh_faces = dexycb_motion_data["object_mesh_faces"]
+            object_pose_list = dexycb_motion_data["object_poses"]  # (N, 4, 4)
+            mesh = trimesh.Trimesh(object_mesh_vertices, object_mesh_faces)
