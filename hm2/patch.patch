+    manipulability_weight: jnp.ndarray,
+) -> jax.Array:
+    joint_var = robot.joint_var_cls(0)
+    variables = [joint_var]
+    costs = [
+        pk.costs.pose_cost_analytic_jac(
+            robot,
+            joint_var,
