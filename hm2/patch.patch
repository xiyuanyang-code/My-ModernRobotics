+    _plot_switch_rate(time_s, actions, os.path.join(save_dir, f"{prefix}_switch_rate.pdf"))
+    _plot_integral_terms(time_s, integral_history, os.path.join(save_dir, f"{prefix}_integral_terms.pdf"))
