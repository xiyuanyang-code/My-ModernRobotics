+        help="Directory to save all results. Auto-generated as results/<env_name>_<timestamp> if not set.",
+    )
+    parser.add_argument(
+        "--r-scale",
+        type=float,
+        default=0.01,
+        help="Control cost multiplier. Smaller = more aggressive torques = faster reaching.",
+    )
+    return parser.parse_args()
+
+
+def main():
